enum UserType {
    STAFF
    LEARNER
    ADMIN
}

enum StaffRole {
    SALES
    PSA
    ACADEMIC_HEAD
    FINANCE
    TA
    PLACEMENT_COORDINATOR
}

enum UserStatus {
    UNACTIVATED
    ACTIVE
    INACTIVE
}

model User {
    id           Int        @id @default(autoincrement())
    publicId     String     @unique @default(uuid()) @map("public_id") @db.Char(36)
    fullName     String     @map("full_name") @db.VarChar(150)
    email        String     @unique
    phone        String     @db.VarChar(50)
    passwordHash String
    userType     UserType
    status       UserStatus @default(UNACTIVATED)
    brandId      Int?       @map("brand_id")
    createdAt    DateTime   @default(now()) @map("created_at")
    updatedAt    DateTime   @updatedAt @map("updated_at")

    brand        Brand?          @relation(fields: [brandId], references: [id], onDelete: Restrict)
    staffRoles   UserStaffRole[]
    inviteTokens InviteToken[]

    @@map("users")
}

model Brand {
    id                      Int      @id @default(autoincrement())
    code                    String   @unique @db.VarChar(50)
    name                    String   @db.VarChar(100)
    baseFee                 Decimal  @map("base_fee") @db.Decimal(12, 2)
    gstInclusive            Boolean  @map("gst_inclusive")
    gstRate                 Decimal  @default(18.00) @map("gst_rate") @db.Decimal(5, 2)
    placementPackageCeiling Decimal  @map("placement_package_ceiling") @db.Decimal(12, 2)
    createdAt               DateTime @default(now()) @map("created_at")
    updatedAt               DateTime @updatedAt @map("updated_at")

    users User[]

    @@map("brands")
}

model UserStaffRole {
    id        Int       @id @default(autoincrement())
    userId    Int       @map("user_id")
    role      StaffRole
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, role])
    @@map("user_staff_roles")
}

model InviteToken {
    id        Int       @id @default(autoincrement())
    userId    Int       @map("user_id")
    tokenHash String    @unique @map("token_hash") @db.Char(64)
    expiresAt DateTime  @map("expires_at")
    usedAt    DateTime? @map("used_at")
    createdAt DateTime  @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("invite_tokens")
}

{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/identity-access/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "rspack",
      "options": {
        "configPath": "rspack.config.cjs"
      }
    },
    "tsConfigPath": "apps/identity-access/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/identity-access",
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "identity-access": {
      "type": "application",
      "root": "apps/identity-access",
      "entryFile": "main",
      "sourceRoot": "apps/identity-access/src",
      "compilerOptions": {
        "tsConfigPath": "apps/identity-access/tsconfig.app.json"
      }
    },
    "model": {
      "type": "library",
      "root": "libs/model",
      "entryFile": "index",
      "sourceRoot": "libs/model/src",
      "compilerOptions": {
        "tsConfigPath": "libs/model/tsconfig.lib.json"
      }
    }
  }
}